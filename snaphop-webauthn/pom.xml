<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.snaphop</groupId>
    <artifactId>snaphop-webauthn-parent</artifactId>
    <version>0.1.0</version>
  </parent>
  <artifactId>snaphop-webauthn</artifactId>
  <name>snaphop-webauthn</name>
  <description>Checks passkey (WebAuthn) registrations and sign-ins on a server: the client data, the authenticator data, COSE keys and signatures</description>

  <!-- JSpecify is the only outside dependency, and only at compile time
       (requires static). Nothing else belongs here. -->
  <dependencies>
    <dependency>
      <groupId>${project.groupId}</groupId>
      <artifactId>snaphop-cbor</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <executions>
          <execution>
            <!-- The javadoc jar that is published, which also fails the
                 build on anything public undocumented. -->
            <id>public-docs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
